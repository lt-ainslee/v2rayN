                                <TextBlock Grid.Column="3" Style="{StaticResource ToolbarTextBlock}" Text="mihomo" />
                            </Grid>
                            <ItemsControl x:Name="lstCapabilityMatrix">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource ToolbarTextBlock}" Text="{Binding Name}" />

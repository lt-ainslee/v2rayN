                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource ToolbarTextBlock}" Text="" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ToolbarTextBlock}" Text="Xray" />

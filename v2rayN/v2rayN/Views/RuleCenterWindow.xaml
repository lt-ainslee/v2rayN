<base:WindowBase
    x:Class="v2rayN.Views.RuleCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:v2rayN.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuRuleCenter}"
    Width="1200"
    Height="800"
    x:TypeArguments="vms:RuleCenterViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Command="{Binding SaveCmd}"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Margin="{StaticResource MarginLeftRight8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="true"
                Style="{StaticResource DefButton}" />
        </StackPanel>

        <TextBlock
            Margin="{StaticResource Margin4}"
            DockPanel.Dock="Top"
            Style="{StaticResource ToolbarTextBlock}"
            Text="{x:Static resx:ResUI.TbRuleCenterTips}"
            TextWrapping="Wrap" />

        <TabControl HorizontalContentAlignment="Left">
            <!--  Rules  -->
            <TabItem Header="{x:Static resx:ResUI.ThRuleCenterRules}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Style="{StaticResource ToolbarTextBlock}"
                                Text="{x:Static resx:ResUI.TbRuleCenterProfile}" />
                            <ComboBox
                                Width="170"
                                Margin="{StaticResource Margin4}"
                                DisplayMemberPath="Remarks"
                                ItemsSource="{Binding Profiles}"
                                SelectedItem="{Binding SelectedProfile}"
                                Style="{StaticResource DefComboBox}" />
                            <Button
                                Margin="{StaticResource Margin4}"
                                Command="{Binding SetActiveProfileCmd}"
                                Content="{x:Static resx:ResUI.TbRuleCenterSetActive}"
                                Style="{StaticResource DefButton}"
                                Visibility="{Binding IsSelectedProfileActive, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Foreground="SeaGreen"
                                Text="{x:Static resx:ResUI.TbRuleCenterActive}"
                                Visibility="{Binding IsSelectedProfileActive, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom">
                            <Button
                                Margin="{StaticResource Margin4}"
                                Command="{Binding AddRuleCmd}"
                                Content="{x:Static resx:ResUI.TbRuleCenterAdd}"
                                Style="{StaticResource DefButton}" />
                            <Button
                                Margin="{StaticResource Margin4}"
                                Command="{Binding DuplicateRuleCmd}"
                                Content="{x:Static resx:ResUI.TbRuleCenterDuplicate}"
                                Style="{StaticResource DefButton}" />
                            <Button
                                Margin="{StaticResource Margin4}"
                                Command="{Binding RemoveRuleCmd}"
                                Content="{x:Static resx:ResUI.TbRuleCenterRemove}"
                                Style="{StaticResource DefButton}" />
                            <Button
                                Margin="{StaticResource Margin4}"
                                Command="{Binding MoveUpCmd}"
                                Content="{x:Static resx:ResUI.TbRuleCenterMoveUp}"
                                Style="{StaticResource DefButton}" />
                            <Button
                                Margin="{StaticResource Margin4}"
                                Command="{Binding MoveDownCmd}"
                                Content="{x:Static resx:ResUI.TbRuleCenterMoveDown}"
                                Style="{StaticResource DefButton}" />
                        </WrapPanel>
                        <Grid Margin="{StaticResource Margin4}" DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Xray" />
                            <TextBlock Grid.Column="2" Text="sing-box" />
                            <TextBlock Grid.Column="3" Text="mihomo" />
                        </Grid>
                        <ListBox
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{Binding Rules}"
                            SelectedItem="{Binding SelectedRule}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox
                                            Grid.RowSpan="2"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Enabled}" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Opacity="0.7"
                                            TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Target, Mode=OneWay}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Summary, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock
                                            Grid.RowSpan="2"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="{Binding XrayMark}" />
                                        <TextBlock
                                            Grid.RowSpan="2"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Text="{Binding SingboxMark}" />
                                        <TextBlock
                                            Grid.RowSpan="2"
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Text="{Binding MihomoMark}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter
                        Grid.Column="1"
                        Width="8"
                        HorizontalAlignment="Stretch" />

                    <TextBlock
                        Grid.Column="2"
                        Margin="{StaticResource Margin8}"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbRuleCenterNoRule}"
                        Visibility="{Binding Editor.HasRule, Converter={StaticResource InverseBoolToVis}}" />
                    <ScrollViewer
                        Grid.Column="2"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding Editor.HasRule, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="{StaticResource Margin4}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.LvRemarks}" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource DefTextBox}"
                                    Text="{Binding Editor.Remarks, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRuleCenterEnabled}" />
                                <ToggleButton
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Margin="{StaticResource Margin4}"
                                    IsChecked="{Binding Editor.Enabled}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRuleCenterTarget}" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="{StaticResource Margin4}"
                                    IsEditable="True"
                                    ItemsSource="{Binding Editor.OutboundOptions}"
                                    Style="{StaticResource DefComboBox}"
                                    Text="{Binding Editor.OutboundTag, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRuleCenterScope}" />
                                <ComboBox
                                    x:Name="cmbRuleType"
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Width="120"
                                    Margin="{StaticResource Margin4}"
                                    SelectedItem="{Binding Editor.RuleType}"
                                    Style="{StaticResource DefComboBox}" />
                            </Grid>

                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                FontWeight="SemiBold"
                                Style="{StaticResource ToolbarTextBlock}"
                                Text="{x:Static resx:ResUI.TbRuleCenterConditions}" />
                            <Grid Margin="{StaticResource Margin4}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="3" Text="Xray" />
                                <TextBlock Grid.Column="4" Text="sing-box" />
                                <TextBlock Grid.Column="5" Text="mihomo" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Editor.Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                Grid.Column="0"
                                                Margin="2,0"
                                                ItemsSource="{Binding KindOptions}"
                                                SelectedItem="{Binding KindName}"
                                                Style="{StaticResource DefComboBox}" />
                                            <TextBox
                                                Grid.Column="1"
                                                Margin="2,0"
                                                IsEnabled="{Binding HasValue}"
                                                Style="{StaticResource DefTextBox}"
                                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox
                                                Grid.Column="2"
                                                Margin="2,0"
                                                VerticalAlignment="Center"
                                                Content="{x:Static resx:ResUI.TbRuleCenterNegate}"
                                                IsChecked="{Binding Negated}"
                                                Visibility="{Binding CanNegate, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Text="{Binding XrayMark}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Text="{Binding SingboxMark}" />
                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Text="{Binding MihomoMark}" />
                                            <Button
                                                Grid.Column="6"
                                                Margin="2,0"
                                                Command="{Binding RemoveCmd}"
                                                Content="{x:Static resx:ResUI.TbRuleCenterRemove}"
                                                Style="{StaticResource DefButton}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left"
                                Command="{Binding Editor.AddConditionCmd}"
                                Content="{x:Static resx:ResUI.TbRuleCenterAddCondition}"
                                Style="{StaticResource DefButton}" />
                            <Grid Margin="{StaticResource Margin4}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Height="60"
                                    materialDesign:HintAssist.Hint="{x:Static resx:ResUI.TbRuleCenterPaste}"
                                    AcceptsReturn="True"
                                    BorderThickness="1"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Editor.BulkText, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                                <Button
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding Editor.AddBulkCmd}"
                                    Content="{x:Static resx:ResUI.TbRuleCenterPasteAdd}"
                                    Style="{StaticResource DefButton}" />
                            </Grid>

                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                FontWeight="SemiBold"
                                Style="{StaticResource ToolbarTextBlock}"
                                Text="{x:Static resx:ResUI.TbRuleCenterConstraints}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="port" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource DefTextBox}"
                                    Text="{Binding Editor.Port, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="network" />
                                <ComboBox
                                    x:Name="cmbNetwork"
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Margin="{StaticResource Margin4}"
                                    SelectedItem="{Binding Editor.Network}"
                                    Style="{StaticResource DefComboBox}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRuleSourceIp}" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource DefTextBox}"
                                    Text="{Binding Editor.SourceIp, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRuleSourcePort}" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource DefTextBox}"
                                    Text="{Binding Editor.SourcePort, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="protocol" />
                                <ItemsControl
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    ItemsSource="{Binding Editor.Protocols}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Margin="4,0,12,0"
                                                Content="{Binding Name}"
                                                IsChecked="{Binding IsChecked}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="{StaticResource Margin4}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="inboundTag" />
                                <ItemsControl
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    ItemsSource="{Binding Editor.InboundTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Margin="4,0,12,0"
                                                Content="{Binding Name}"
                                                IsChecked="{Binding IsChecked}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Expander Margin="{StaticResource Margin4}" Header="{x:Static resx:ResUI.TbRuleCoreExt}">
                                <UniformGrid Columns="3">
                                    <TextBox
                                        Height="80"
                                        Margin="2"
                                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.TbRuleXrayJson}"
                                        AcceptsReturn="True"
                                        BorderThickness="1"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Editor.XrayJson, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalScrollBarVisibility="Auto" />
                                    <TextBox
                                        Height="80"
                                        Margin="2"
                                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.TbRuleSingboxJson}"
                                        AcceptsReturn="True"
                                        BorderThickness="1"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Editor.SingboxJson, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalScrollBarVisibility="Auto" />
                                    <TextBox
                                        Height="80"
                                        Margin="2"
                                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.TbRuleMihomoRules}"
                                        AcceptsReturn="True"
                                        BorderThickness="1"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Editor.MihomoRules, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalScrollBarVisibility="Auto" />
                                </UniformGrid>
                            </Expander>

                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                FontWeight="SemiBold"
                                Style="{StaticResource ToolbarTextBlock}"
                                Text="{x:Static resx:ResUI.TbRuleCenterCompatibility}" />
                            <TextBox
                                Margin="{StaticResource Margin4}"
                                BorderThickness="0"
                                IsReadOnly="True"
                                Text="{Binding Editor.CompatibilityText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!--  DNS  -->
            <TabItem Header="DNS">
                <local:DnsSettingsPanel x:Name="dnsPanel" />
            </TabItem>

            <!--  Policy groups  -->
            <TabItem Header="{x:Static resx:ResUI.ThRuleCenterGroups}">
                <DockPanel>
                    <TextBlock
                        Margin="{StaticResource Margin4}"
                        DockPanel.Dock="Top"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbRuleCenterGroupsTips}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="{StaticResource Margin8}"
                        DockPanel.Dock="Top"
                        Opacity="0.7"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbRuleCenterNoGroups}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasPolicyGroups, Converter={StaticResource InverseBoolToVis}}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <Button
                            Margin="{StaticResource Margin4}"
                            Command="{Binding AddPolicyGroupCmd}"
                            Content="{x:Static resx:ResUI.TbRuleCenterAddGroup}"
                            Style="{StaticResource DefButton}" />
                        <Button
                            Margin="{StaticResource Margin4}"
                            Command="{Binding AddProxyChainCmd}"
                            Content="{x:Static resx:ResUI.TbRuleCenterAddChain}"
                            Style="{StaticResource DefButton}" />
                        <Button
                            Margin="{StaticResource Margin4}"
                            Command="{Binding EditPolicyGroupCmd}"
                            Content="{x:Static resx:ResUI.TbRuleCenterEditGroup}"
                            Style="{StaticResource DefButton}" />
                    </StackPanel>
                    <ListBox
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding PolicyGroups}"
                        SelectedItem="{Binding SelectedPolicyGroup}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Remarks}" />
                                    <TextBlock Opacity="0.7" Text="{Binding TypeName}" />
                                    <TextBlock
                                        Opacity="0.7"
                                        Text="{Binding Members}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!--  Rule sets  -->
            <TabItem Header="{x:Static resx:ResUI.TbRuleSets}">
                <DockPanel>
                    <TextBlock
                        Margin="{StaticResource Margin4}"
                        DockPanel.Dock="Top"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbRuleCenterRuleSetsTips}"
                        TextWrapping="Wrap" />
                    <Grid Margin="{StaticResource Margin4}" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static resx:ResUI.TbRuleCenterRuleSetName}" />
                        <TextBlock Grid.Column="1" Text="{x:Static resx:ResUI.TbRuleCenterRuleSetBehavior}" />
                        <TextBlock Grid.Column="2" Text="{x:Static resx:ResUI.TbRuleCenterRuleSetSingbox}" />
                        <TextBlock Grid.Column="3" Text="{x:Static resx:ResUI.TbRuleCenterRuleSetMihomo}" />
                        <TextBlock Grid.Column="4" Text="{x:Static resx:ResUI.TbRuleCenterRuleSetInterval}" />
                    </Grid>
                    <TextBlock
                        Margin="{StaticResource Margin8}"
                        DockPanel.Dock="Top"
                        Opacity="0.7"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbRuleCenterNoRuleSets}"
                        Visibility="{Binding HasRuleSets, Converter={StaticResource InverseBoolToVis}}" />
                    <Button
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        Command="{Binding AddRuleSetCmd}"
                        Content="{x:Static resx:ResUI.TbRuleCenterAddRuleSet}"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource DefButton}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RuleSets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            Margin="2,0"
                                            Style="{StaticResource DefTextBox}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Margin="2,0"
                                            ItemsSource="{Binding BehaviorOptions}"
                                            SelectedItem="{Binding Behavior}"
                                            Style="{StaticResource DefComboBox}" />
                                        <TextBox
                                            Grid.Column="2"
                                            Margin="2,0"
                                            Style="{StaticResource DefTextBox}"
                                            Text="{Binding SingboxSource, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="3"
                                            Margin="2,0"
                                            Style="{StaticResource DefTextBox}"
                                            Text="{Binding MihomoSource, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="4"
                                            Margin="2,0"
                                            Style="{StaticResource DefTextBox}"
                                            Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="5"
                                            Margin="2,0"
                                            Command="{Binding RemoveCmd}"
                                            Content="{x:Static resx:ResUI.TbRuleCenterRemove}"
                                            Style="{StaticResource DefButton}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!--  Core extensions  -->
            <TabItem Header="{x:Static resx:ResUI.ThRuleCenterExtensions}">
                <local:CoreExtensionPanel x:Name="extensionPanel" />
            </TabItem>

            <!--  Preview  -->
            <TabItem Header="{x:Static resx:ResUI.ThUnifiedPreview}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbPreviewCore}" />
                        <ComboBox
                            x:Name="cmbPreviewCore"
                            Width="160"
                            Margin="{StaticResource Margin4}"
                            SelectedItem="{Binding PreviewCore}"
                            Style="{StaticResource DefComboBox}" />
                        <Button
                            Margin="{StaticResource Margin4}"
                            Command="{Binding PreviewCmd}"
                            Content="{x:Static resx:ResUI.TbPreviewGenerate}"
                            Style="{StaticResource DefButton}" />
                        <TextBlock
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbRuleCenterPreviewTips}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox
                        Margin="{StaticResource Margin4}"
                        AcceptsReturn="True"
                        BorderThickness="1"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding PreviewText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>

            <!--  Capability matrix  -->
            <TabItem Header="{x:Static resx:ResUI.ThCapabilityMatrix}">
                <DockPanel>
                    <TextBlock
                        Margin="{StaticResource Margin4}"
                        DockPanel.Dock="Top"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbCapabilityMatrixTips}" />
                    <Grid Margin="{StaticResource Margin4}" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Xray" />
                        <TextBlock Grid.Column="2" Text="sing-box" />
                        <TextBlock Grid.Column="3" Text="mihomo" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="{StaticResource Margin4}" ItemsSource="{Binding CapabilityRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Xray}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Singbox}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Mihomo}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</base:WindowBase>
